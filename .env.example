# Copy to .env (or set in your host's dashboard). Only DATABASE_URL is required.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/incidentroom
PORT=4000

# Webhook auth: use long random strings in production.
GITHUB_WEBHOOK_SECRET=dev-github-secret
SENTRY_WEBHOOK_SECRET=dev-sentry-secret
INGEST_TOKEN=dev-ingest-token

# Optional: real AI postmortems (otherwise a template draft is used).
AI_API_KEY=

# Optional: fan out live updates across several server instances.
REDIS_URL=
